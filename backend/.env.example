# Copy to backend/.env and edit. NEVER commit the real .env file.

# Server
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgres://queue_user:change_me@localhost:5432/smart_office_queue?sslmode=disable

# JWT signing secret: at least 16 characters, ideally 32+ random characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=my-very-long-secret-key-12345
JWT_TTL_HOURS=12

# Comma-separated list of allowed browser origins, or * for local development.
CORS_ALLOWED_ORIGINS=*

# Demo accounts: when SEED_ON_START=true the server creates the admin/staff
# users below (once) using SEED_PASSWORD. Turn it off in production.
SEED_ON_START=true
SEED_PASSWORD=Demo@12345
